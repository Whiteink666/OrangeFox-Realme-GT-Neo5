#!/sbin/sh
# Whiteink fox-pulse —— 第三包：振幅恢复出厂 + 打开双脉冲
#
# 上一包证明 fifo_vmax 9100 -> 11375（+25%）会让 LRA 撞限位、变成转子嗡嗡感。
# 也就是说振幅已经是线性上限附近，不能靠加幅度变强。
#
# 本包换一个维度：振幅不动，把同一段波形连打两发（≈81ms + 81ms），
# 靠时长/累积能量提升"强度感"，不削顶所以不会变转子。
#
# 开关是 /tmp/fox_haptics_double，v4 代码每次点击都会 access() 检查它，
# 所以刷完立刻生效，不需要重编译。
# 注意：/tmp 是内存盘，重启后失效（正好作为自动回退）。

OUTFD="$2"
LOG=/tmp/fox_pulse.txt
: > "$LOG" 2>/dev/null
Q=/sys/class/qcom-haptics

ui() {
    if [ -n "$OUTFD" ]; then
        echo "ui_print $1" >&"$OUTFD" 2>/dev/null
        echo "ui_print" >&"$OUTFD" 2>/dev/null
    fi
    echo "$1" >> "$LOG" 2>/dev/null
}
sec() { ui " "; ui "======== $1 ========"; }

sec "1/3 振幅恢复出厂值"
restore() {  # $1=节点名 $2=出厂值
    f="$Q/$1"
    [ -e "$f" ] || { ui "  $1: 节点不存在，跳过"; return; }
    cur=$(cat "$f" 2>/dev/null | tr -d ' \t\r\n')
    before="$cur"
    if [ "$cur" != "$2" ]; then
        echo "$2" > "$f" 2>/dev/null
        cur=$(cat "$f" 2>/dev/null | tr -d ' \t\r\n')
        ui "  $1: $before -> 写 $2 -> 回读 $cur"
    else
        ui "  $1: 已是出厂值 $cur"
    fi
}
restore vmax 1280
restore fifo_vmax 9100

sec "2/3 打开双脉冲（同一振幅打两发）"
rm -f /tmp/fox_haptics_force_on 2>/dev/null
rm -f /tmp/fox_haptics_gain 2>/dev/null
ui "  已清除 force_on / gain（保证只测一个变量）"
: > /tmp/fox_haptics_double 2>/dev/null
if [ -f /tmp/fox_haptics_double ]; then
    ui "  /tmp/fox_haptics_double 已创建"
else
    ui "  创建失败！双脉冲不会生效"
fi
ui "  校验: $(ls -l /tmp/fox_haptics_double 2>/dev/null | sed 's/.* //')"

sec "3/3 请你验证"
ui "  1) 返回主菜单 -> 设置 -> 振动强度拉到 300（满）"
ui "  2) 点几个按钮或滑动列表"
ui "  3) 告诉我：够强且不嗡 / 还是偏弱 / 又变嗡嗡"
ui " "
ui "  不要重启：/tmp 里的开关重启即失效"
ui "  若震动变怪，重启一次就回到原厂手感"

SAVED=""
for d in /sdcard /data/media/0 /tmp; do
    if [ -d "$d" ]; then
        cp -f "$LOG" "$d/fox_pulse.txt" 2>/dev/null && SAVED="$d/fox_pulse.txt" && break
    fi
done
ui " "
ui "结果: ${SAVED:-/tmp/fox_pulse.txt}"
ui "完成"
