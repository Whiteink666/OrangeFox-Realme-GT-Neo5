#!/sbin/sh
# Whiteink fox-oneshot —— 第四包：绕开波形，直接用 on() 谐振驱动
#
# 已经验证过的三条结论：
#   1) 振幅不能再加：fifo_vmax 9100 -> 11375 会削顶变转子嗡嗡
#   2) 时长不是强度：同一波形连打两发（81+81ms）只变长不变重
#   3) 波形路径 amp=1.00 / used=3 已是最强，setAmplitude 对波形无效
#
# 唯一没试过的是完全绕开 RichTap 波形，改走 AIDL 的 on(duration)：
# 马达在谐振点（lra_frequency_hz=174）被满幅驱动 60ms，振幅由 vmax=1280
# （不是 fifo_vmax）决定，是另一条独立通道。
#
# 开关 /tmp/fox_haptics_force_on 由 v4 代码每次点击 access() 检查，即时生效。

OUTFD="$2"
LOG=/tmp/fox_oneshot.txt
: > "$LOG" 2>/dev/null
Q=/sys/class/qcom-haptics

ui() {
    if [ -n "$OUTFD" ]; then
        echo "ui_print $1" >&"$OUTFD" 2>/dev/null
        echo "ui_print" >&"$OUTFD" 2>/dev/null
    fi
    echo "$1" >> "$LOG" 2>/dev/null
}
sec() { ui " "; ui "======== $1 ========"; }

sec "1/3 确认振幅是出厂值"
for pair in "vmax 1280" "fifo_vmax 9100"; do
    n=${pair% *}; want=${pair#* }
    f="$Q/$n"
    if [ -e "$f" ]; then
        cur=$(cat "$f" 2>/dev/null | tr -d ' \t\r\n')
        if [ "$cur" != "$want" ]; then
            echo "$want" > "$f" 2>/dev/null
            ui "  $n: $cur -> $want（回读 $(cat "$f" 2>/dev/null | tr -d ' \t\r\n')）"
        else
            ui "  $n = $cur（出厂值，正常）"
        fi
    fi
done

sec "2/3 切换驱动路径：波形 -> on() 谐振驱动"
rm -f /tmp/fox_haptics_double 2>/dev/null
rm -f /tmp/fox_haptics_gain 2>/dev/null
ui "  已关闭双脉冲与增益（单变量测试）"
: > /tmp/fox_haptics_force_on 2>/dev/null
if [ -f /tmp/fox_haptics_force_on ]; then
    ui "  /tmp/fox_haptics_force_on 已创建 -> 走 mode=2"
else
    ui "  创建失败！仍会走波形路径"
fi

sec "3/3 请你验证"
ui "  1) 回主菜单 -> 设置 -> 振动强度 300"
ui "  2) 点几个按钮"
ui "  3) 告诉我：明显更重且干净 / 更弱 / 发闷嗡嗡"
ui " "
ui "  这一版是纯 174Hz 正弦满幅驱动 60ms"
ui "  若手感不对，重启即恢复（/tmp 开关随重启失效）"
ui "  日志: /tmp/fox_haptics.log 里应变成 mode=2"

SAVED=""
for d in /sdcard /data/media/0 /tmp; do
    if [ -d "$d" ]; then
        cp -f "$LOG" "$d/fox_oneshot.txt" 2>/dev/null && SAVED="$d/fox_oneshot.txt" && break
    fi
done
ui " "
ui "结果: ${SAVED:-/tmp/fox_oneshot.txt}"
ui "完成"
