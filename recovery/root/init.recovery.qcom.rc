import /init.recovery.qcom_decrypt.rc

service variant-script /system/bin/variant-script.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on init
    start boot-hal-1-2

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

# Whiteink: R12 renders SVG icons, shadows and rounded corners purely on the
# CPU at 1240x2772, and the default "balanced" governor visibly drops frames
# during gesture navigation and page transitions. Lock all clusters to the
# performance governor while recovery is running.
# /sbin/setgovernor ships with OrangeFox R12; it checks
# scaling_available_governors and skips offline CPUs, so this is safe even if
# the kernel does not expose "performance". Users can still override it at
# runtime from Settings -> Performance.
service fox_perf /system/bin/sh /sbin/setgovernor performance
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Best-effort 144 Hz panel mode. The script probes sysfs, verifies by
# readback, rolls back on rejection and always exits 0 - a missing node can
# never block recovery from starting. See sbin/fox_refresh.sh.
service fox_refresh /system/bin/sh /sbin/fox_refresh.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on boot
    setprop sys.usb.config adb
    start variant-script
    start fox_perf
    start fox_refresh

on property:twrp.modules.loaded=true
    start touch_report
    # Mount firmware
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/class/power_supply/battery
    start health-hal-2-1
    # aw8697.ko is explicitly listed in TW_LOAD_VENDOR_MODULES; give the
    # driver a moment to create /dev/awinic_haptic before the AIDL service
    # starts. The short timeout keeps a failed insmod from stalling the boot.
    wait /dev/awinic_haptic 2
    start realme.vibrator
    start fox_refresh
    umount /firmware

service modules_mount /system/bin/modules_mount.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:twrp.decrypt.done=true
    start modules_mount
    # OrangeFox re-applies its own performance mode during startup, so
    # re-assert the governor after decryption, once the UI is about to run.
    start fox_perf
    # Re-assert the panel mode too: some display nodes only become writable
    # after decryption / full display init. The script is idempotent.
    start fox_refresh
